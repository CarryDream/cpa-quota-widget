{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cpa-quota-widget",
  "version": "0.1.0",
  "identifier": "com.cpa.quota.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:18320",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CPA 额度悬浮卡片",
        "width": 320,
        "height": 280,
        "minWidth": 260,
        "minHeight": 100,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
